{
  "name": "free-finance-camp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run lessons:export && vite",
    "seo:sitemap": "node scripts/generate-sitemap.mjs",
    "xp:sql": "node scripts/generate-lesson-xp-sql.mjs",
    "lessons:export": "node scripts/export-lesson-content.mjs",
    "lessons:watch": "node scripts/export-lesson-content.mjs --watch",
    "build": "npm run lessons:export && npm run seo:sitemap && npm run xp:sql && vite build && npm run seo:prerender",
    "lint": "eslint .",
    "preview": "vite preview",
    "deploy": "npm run build && firebase deploy",
    "ios:add": "npx cap add ios",
    "ios:sync": "npm run build && npx cap sync ios",
    "ios:open": "npx cap open ios",
    "seo:prerender": "node scripts/prerender.mjs"
  },
  "dependencies": {
    "@capacitor/cli": "^8.1.0",
    "@capacitor/core": "^8.1.0",
    "@capacitor/ios": "^8.1.0",
    "@supabase/supabase-js": "^2.91.1",
    "firebase": "^12.9.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.12.0",
    "recharts": "^3.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "playwright": "^1.65.0",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3",
    "vite": "^7.2.4"
  }
}
